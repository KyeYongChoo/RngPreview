<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless check of RngPreview's predictors on a real run, booted by the SeedSearch tool
    (C:\Users\chook\Desktop\Searching for an Unwinnable Seed). Compiles RngPreview's Sim.cs and Effects.cs directly.
    Usage: see CLAUDE.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS8600;CS8602;CS8604</NoWarn>
    <SeedSearchBin Condition="'$(SeedSearchBin)' == ''">C:\Users\chook\Desktop\Searching for an Unwinnable Seed\SeedSearch\bin\Release\net9.0</SeedSearchBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Sim.cs" />
    <Compile Include="..\..\Effects.cs" />
    <Reference Include="sts2"><HintPath>$(SeedSearchBin)\sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(SeedSearchBin)\GodotSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(SeedSearchBin)\0Harmony.dll</HintPath></Reference>
  </ItemGroup>
  <!-- SeedSearch and the game assemblies it needs, next to the exe. -->
  <Target Name="CopySeedSearch" AfterTargets="Build">
    <ItemGroup><SeedSearchDlls Include="$(SeedSearchBin)\*.dll" /></ItemGroup>
    <Copy SourceFiles="@(SeedSearchDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
