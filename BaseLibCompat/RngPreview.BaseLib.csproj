<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional BaseLib integration. Built automatically by ../RngPreview.csproj when BaseLib is installed. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>RngPreview.BaseLib</AssemblyName>
    <RootNamespace>RngPreview.BaseLibCompat</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>../bin/$(Configuration)/net9.0/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</GameDir>
    <!-- BaseLib from the Steam Workshop (item 3737335127). Override with -p:BaseLibDll="...". -->
    <BaseLibDll Condition="'$(BaseLibDll)' == ''">$(GameDir)\..\..\..\workshop\content\2868840\3737335127\BaseLib\BaseLib.dll</BaseLibDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RngPreview"><HintPath>../bin/$(Configuration)/net9.0/RngPreview.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BaseLib"><HintPath>$(BaseLibDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="sts2"><HintPath>$(GameDir)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDir)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
